# MongoDB (must be a replica set - MongoDB Atlas works out of the box)
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/xenelle?retryWrites=true&w=majority"

# next-auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_JWT_SECRET="generate-with: openssl rand -base64 32"

# used by trpc/client.tsx during SSR
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# seed admin (npm run db:seed)
ADMIN_EMAIL="admin@xenelle.pk"
ADMIN_PASSWORD="Admin@12345"

# Cloudinary (product images + advance payment screenshots)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# public site origin for canonical URLs / sitemap / OG tags
NEXT_PUBLIC_SITE_URL="https://xenelle.pk"
